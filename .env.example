# Copy to .env for local development. NEVER commit real values.
APP_ENV=development
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Local default is SQLite. Railway injects postgresql://... automatically.
DATABASE_URL=sqlite:///./dev.db

# LLM provider: gemini (Google AI Studio key) | anthropic
LLM_PROVIDER=gemini
LLM_API_KEY=
# Empty = provider default (gemini-3.6-flash / claude-opus-5)
LLM_MODEL=
# Model for analyze_email; a different model has its own free-tier quota. Empty = LLM_MODEL
LLM_ANALYSIS_MODEL=
# Anthropic only
LLM_EFFORT=medium

# Agent safety limits
MAX_AGENT_STEPS=10
# In-run automatic retries for transient LLM failures (5xx, timeout, per-minute limit) before the run is marked FAILED
LLM_TRANSIENT_RETRIES=2
AGENT_TIMEOUT_SECONDS=420
# Client-side requests/minute cap (Gemini free tier: 5). 0 = off
LLM_RPM_LIMIT=5

# Production: public URL of the app (used for Origin/CSRF checks) and host allowlist
PUBLIC_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Demo account created at startup (optional)
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=

# Google (Gmail / Calendar) connection. All three must be set, otherwise Google features are off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 (encrypts refresh tokens). Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
GOOGLE_TOKEN_KEY=
# Mail sync
MAIL_SYNC_ENABLED=true
MAIL_SYNC_INTERVAL_SECONDS=90
MAIL_BACKFILL_DAYS=3
MAIL_SYNC_MAX_PER_CYCLE=200
USER_TIMEZONE=Asia/Seoul
# Mail triage + intake: sends mail text (sender, subject, body excerpt) to the LLM provider.
# Gemini's free tier uses inputs to improve products - turn on only if you accept that.
MAIL_TRIAGE_ENABLED=false
MAIL_TRIAGE_BATCHES_PER_CYCLE=3
MAIL_INTAKE_PER_CYCLE=5
# Google Calendar sync: max tasks sent to the Calendar API per sync cycle.
CALENDAR_SYNC_PER_CYCLE=10
